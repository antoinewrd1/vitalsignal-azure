# Copy to .env and fill in. Nothing here is required for the LOCAL backend.

# ---- Backend switch -------------------------------------------------------
VS_BACKEND=local                  # local | azure
VS_LOCAL_ROOT=./_lake             # where the local lakehouse lives
VS_TABLE_FORMAT=parquet           # parquet (local) | delta (Databricks)

# ---- ADLS Gen2 ------------------------------------------------------------
VS_STORAGE_ACCOUNT=stvitalsignal
VS_CONTAINER=lakehouse

# ---- Azure ML -------------------------------------------------------------
VS_MLFLOW_TRACKING_URI=./_mlruns   # replace with azureml:// URI in Azure
VS_MODEL_NAME=outbreak_signal_clf

# ---- Azure OpenAI ---------------------------------------------------------
VS_LLM_BACKEND=fake                # fake | azure_openai
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Auth: prefer Entra ID (DefaultAzureCredential). Key only as a fallback.
AZURE_OPENAI_API_KEY=

# ---- Azure AI Search ------------------------------------------------------
VS_SEARCH_BACKEND=local            # local | azure_search
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=phguidance
AZURE_SEARCH_API_KEY=
